[Unit]
Description=Alertmanager EC2 scale webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/alertmanager
ExecStart=/usr/bin/python3 /home/ubuntu/alertmanager/scale_webhook.py
Restart=always
RestartSec=5
EnvironmentFile=-/home/ubuntu/alertmanager/scale-webhook.env
Environment=SCALE_WEBHOOK_HOST=0.0.0.0
Environment=SCALE_WEBHOOK_PORT=5001
Environment=SCALE_WEBHOOK_COOLDOWN_SECONDS=1800
# Put server-specific values in alertmanager/scale-webhook.env.
# SCALE_SERVER_IP=YOUR_TERRAFORM_SERVER_IP
# SCALE_SSH_USER=ubuntu
# SCALE_SSH_KEY=/home/ubuntu/alertmanager/kien.pem
# SCALE_WORKFLOW_DIR=/home/ubuntu
# SCALE_WORKFLOW_SCRIPT=ansible-web/provision-ec2-and-run-ansible.sh

[Install]
WantedBy=multi-user.target
