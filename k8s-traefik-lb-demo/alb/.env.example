# Host header HAProxy uses for Traefik health checks.
ALB_DOMAIN=benhvien.teamdevops.shop

# Traefik HTTP NodePort from k8s/04-traefik-service.yaml.
TRAEFIK_HTTP_NODEPORT=30080

# Traefik HTTPS NodePort from k8s/04-traefik-service.yaml.
TRAEFIK_HTTPS_NODEPORT=30443

# Node selector used by kubectl discovery. Keep empty to scan all nodes.
KUBE_NODE_SELECTOR=

# Only include nodes that have a Running Traefik pod. Keep this true when
# Traefik Service uses externalTrafficPolicy: Local.
DISCOVER_TRAEFIK_PODS=true
TRAEFIK_NAMESPACE=traefik
TRAEFIK_POD_SELECTOR=app=traefik

# Address type from kubectl get nodes: InternalIP or ExternalIP.
KUBE_NODE_ADDRESS_TYPE=InternalIP

# Output config mounted by docker-compose.yml.
HAPROXY_CONFIG=haproxy.cfg

# Host ports published by Docker Compose.
HAPROXY_HTTP_PORT=80
HAPROXY_HTTPS_PORT=443
